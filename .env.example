# DUALITY configuration. Copy to .env, fill in, never commit .env.
# Every script reads this file, or the path in $DUALITY_ENV, or the process
# environment. Nothing here reads a path outside the project.

# EVM JSON-RPC endpoint for the target network (Base Sepolia, chain 84532)
RPC_URL=

# Role keys and addresses. Three distinct addresses are required: the core
# rejects a job whose client, provider and evaluator are not distinct.
ADDRESS=
PRIVATE_KEY=

BUYER=
BUYER_KEY=

PROVIDER=
PROVIDER_KEY=

JUDGE=
JUDGE_KEY=

# KeeperHub direct-execution API key (kh_...). Supply it through the
# environment; it is never read from a file this project does not own.
KH_API_KEY=
