# DUALITY configuration. Copy to .env, fill in, never commit .env.
# Every script reads this file, or the path in $DUALITY_ENV, or the process
# environment. Nothing here reads a path outside the project.

# EVM JSON-RPC endpoint for the target network (Base Sepolia, chain 84532)
RPC_URL=

# Role keys and addresses. Three distinct addresses are required: the core
# rejects a job whose client, provider and evaluator are not distinct.
ADDRESS=
PRIVATE_KEY=

BUYER=
BUYER_KEY=

PROVIDER=
PROVIDER_KEY=

JUDGE=
JUDGE_KEY=

# KeeperHub direct-execution API key (kh_...). Supply it through the
# environment; it is never read from a file this project does not own.
KH_API_KEY=

# The ACP lane: a job whose escrow pays an agent that exists in the ACP registry.
# That lane refuses to run without all three, because the point of it is a named
# counterparty rather than an anonymous address.
ACP_AGENT_ID=
ACP_AGENT_WALLET=
ACP_AGENT_REGISTRY=

# Optional. Set this only if the registry issues a numeric agent identity, in which
# case the lane also writes it to the job's providerAgentId field.
ACP_AGENT_TOKEN_ID=

# Optional escrow size for the ACP lane, in USDC. Defaults to 1.
ACP_JOB_USDC=
